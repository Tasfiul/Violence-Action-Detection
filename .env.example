# ==============================================================================
# SENTINAI // VIOLENCE ACTION DETECTION - ENVIRONMENT CONFIG TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to `.env` to configure your machine's hardware settings.
#
# QUICK PRESET PROFILES:
#
# ------------------------------------------------------------------------------
# [PRESET 1] LOWER-VRAM SYSTEMS (4GB VRAM or below / Budget Systems):
# ------------------------------------------------------------------------------
# SYSTEM_DEVICE=cuda
# HEADLESS=false
# TORCH_BENCHMARK=true
#
# DETECTION_DEVICE=cuda
# DETECTION_MODEL_WEIGHTS=models/yolov8n.pt
# DETECTION_CONF_THRESHOLD=0.50
# DETECTION_IMGSZ=640
# DETECTION_HALF_PRECISION=true
# DETECTION_FRAME_SKIP=1
#
# ACTION_DEVICE=cpu
# ACTION_HALF_PRECISION=true
# ACTION_SAMPLE_FRAMES=1
# ACTION_WINDOW_SIZE=8
# ACTION_STRIDE=4
# ACTION_MOTION_THRESHOLD=15.0
# ACTION_ANALYSIS_COOLDOWN=1.5
# ACTION_CONFIDENCE_THRESHOLD=0.60
# ACTION_ALERT_TRIGGER_COUNT=2
# ACTION_QUEUE_SIZE=1
#
# VLM_ENABLED=false
#
# ------------------------------------------------------------------------------
# [PRESET 2] MID-TO-HIGH TIER SYSTEMS (6GB - 8GB VRAM or higher):
# ------------------------------------------------------------------------------
# SYSTEM_DEVICE=cuda
# HEADLESS=false
# TORCH_BENCHMARK=true
#
# DETECTION_DEVICE=cuda
# DETECTION_MODEL_WEIGHTS=models/yolov8s.pt
# DETECTION_CONF_THRESHOLD=0.45
# DETECTION_IMGSZ=640
# DETECTION_HALF_PRECISION=true
# DETECTION_FRAME_SKIP=1
#
# ACTION_DEVICE=cuda
# ACTION_HALF_PRECISION=true
# ACTION_SAMPLE_FRAMES=3
# ACTION_WINDOW_SIZE=12
# ACTION_STRIDE=2
# ACTION_MOTION_THRESHOLD=8.0
# ACTION_ANALYSIS_COOLDOWN=0.4
# ACTION_CONFIDENCE_THRESHOLD=0.60
# ACTION_ALERT_TRIGGER_COUNT=2
# ACTION_QUEUE_SIZE=4
#
# VLM_ENABLED=true
# VLM_PROVIDER=local
# VLM_MODEL_ID=qwen2.5vl:3b
#
# ------------------------------------------------------------------------------
# [PRESET 3] ULTRA / SERVER TIER SYSTEMS (12GB+ VRAM):
# ------------------------------------------------------------------------------
# SYSTEM_DEVICE=cuda
# HEADLESS=false
# TORCH_BENCHMARK=true
#
# DETECTION_DEVICE=cuda
# DETECTION_MODEL_WEIGHTS=models/yolov8m.pt
# DETECTION_CONF_THRESHOLD=0.40
# DETECTION_IMGSZ=1280
# DETECTION_HALF_PRECISION=true
# DETECTION_FRAME_SKIP=1
#
# ACTION_DEVICE=cuda
# ACTION_HALF_PRECISION=true
# ACTION_SAMPLE_FRAMES=6
# ACTION_WINDOW_SIZE=16
# ACTION_STRIDE=1
# ACTION_MOTION_THRESHOLD=5.0
# ACTION_ANALYSIS_COOLDOWN=0.2
# ACTION_CONFIDENCE_THRESHOLD=0.60
# ACTION_ALERT_TRIGGER_COUNT=2
# ACTION_QUEUE_SIZE=8
#
# VLM_ENABLED=true
# VLM_PROVIDER=local
# VLM_MODEL_ID=qwen2.5vl:7b
#
# ------------------------------------------------------------------------------
# [PRESET 4] CPU-ONLY SYSTEMS (No Dedicated GPU):
# ------------------------------------------------------------------------------
# SYSTEM_DEVICE=cpu
# DETECTION_DEVICE=cpu
# DETECTION_MODEL_WEIGHTS=models/yolov8n.pt
# DETECTION_IMGSZ=480
# DETECTION_HALF_PRECISION=false
# DETECTION_FRAME_SKIP=2
# ACTION_DEVICE=cpu
# ACTION_SAMPLE_FRAMES=1
# ACTION_WINDOW_SIZE=8
# ACTION_STRIDE=6
# ACTION_MOTION_THRESHOLD=20.0
# ACTION_ANALYSIS_COOLDOWN=2.5
# VLM_ENABLED=false
# ==============================================================================

# ==============================================================================
# 1. HARDWARE & SYSTEM SETTINGS
# ==============================================================================

# SYSTEM_DEVICE: Global default execution device for neural models.
# Current Value: cuda
# Options: cuda, cpu
# Effect: 'cuda' offloads tensor math to the dedicated GPU for hardware acceleration.
SYSTEM_DEVICE=cuda

# HEADLESS: Whether to disable OpenCV GUI window display.
# Current Value: false
# Options: true (no display window, saves CPU/GPU rendering overhead), false (opens preview window)
# Effect: Setting to 'true' frees rendering compute when using the Web Dashboard or running benchmarks.
HEADLESS=false

# LOG_LEVEL: Console logging verbosity.
# Current Value: INFO
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# TORCH_BENCHMARK: Enables torch.backends.cudnn.benchmark for fixed-size input acceleration.
# Current Value: true
# Options: true, false
# Effect: Speeds up deep learning convolutions on GPU after initial warmup frames.
TORCH_BENCHMARK=true

# DISPLAY_WIDTH & DISPLAY_HEIGHT: OpenCV GUI window size.
# Current Value: 1280 x 720
# Effect: Changes preview window dimensions. Does not affect model input resolution or accuracy.
DISPLAY_WIDTH=1280
DISPLAY_HEIGHT=720

# VIDEO_PLAYBACK_REALTIME: Paces video playback to match original video FPS (~30 FPS).
# Current Value: true
# Options: true (smooth real-time playback), false (runs as fast as hardware allows)
# Effect: Set to 'false' if running benchmarks or processing historical video archives at maximum throughput.
VIDEO_PLAYBACK_REALTIME=true


# ==============================================================================
# 2. PHASE 1: SPATIAL PERCEPTION & DETECTION (YOLOv8 + ByteTrack)
# ==============================================================================

# DETECTION_DEVICE: Execution device specifically for YOLO person detection.
# Current Value: cuda
# Lower-VRAM Tier (4GB): cuda
# Mid-to-High Tier (6-8GB+): cuda
DETECTION_DEVICE=cuda

# DETECTION_MODEL_WEIGHTS: YOLO weights file path.
# Current Value: models/yolov8n.pt
# Options:
#   - models/yolov8n.pt (Nano: fastest, lowest VRAM ~200MB, best for budget GPUs)
#   - models/yolov8s.pt (Small: higher accuracy on small or distant persons, ~450MB VRAM)
#   - models/yolov8m.pt (Medium: high accuracy in crowded scenes, ~1GB VRAM)
# Effect: Larger models detect smaller persons and partial occlusions with higher accuracy at the cost of FPS.
DETECTION_MODEL_WEIGHTS=models/yolov8n.pt

# DETECTION_CONF_THRESHOLD: Minimum confidence to consider a detected person.
# Current Value: 0.50
# Effect: Lower (0.35-0.45) detects occluded people but tracks more items; Higher (0.55-0.65) reduces false detections.
DETECTION_CONF_THRESHOLD=0.50

# DETECTION_IOU_THRESHOLD: Non-Maximum Suppression (NMS) IoU overlap threshold.
# Current Value: 0.45
# Effect: Higher preserves separate boxes when persons are close together; Lower merges overlapping boxes.
DETECTION_IOU_THRESHOLD=0.45

# DETECTION_IMGSZ: YOLO input image resolution (square dimension).
# Current Value: 640
# Lower-VRAM Tier (4GB): 640 (or 480 for maximum FPS)
# Mid-to-High Tier (6-8GB+): 640 (or 800 / 1280 for sharp detection of distant persons)
# Effect: Lower speeds up inference; Higher detects smaller and more distant persons.
DETECTION_IMGSZ=640

# DETECTION_HALF_PRECISION: Enables FP16 (Half Precision) tensor cores on NVIDIA GPUs.
# Current Value: true
# Options: true, false
# Effect: Cuts YOLO VRAM usage in half and accelerates inference by ~1.5x - 2x with zero loss in accuracy.
DETECTION_HALF_PRECISION=true

# DETECTION_FRAME_SKIP: Run YOLO inference every N frames.
# Current Value: 1 (process every single frame)
# Lower-VRAM Tier (4GB): 1 (or 2 if system thermal throttles to cut GPU load by 50%)
# Mid-to-High Tier (6-8GB+): 1
# Effect: Setting to 2 skips inference on alternate frames while maintaining tracks, halving GPU detection load.
DETECTION_FRAME_SKIP=1

# TRACKER_ACTIVATION_THRESHOLD: Minimum detection score to initialize a new person track.
# Current Value: 0.25
TRACKER_ACTIVATION_THRESHOLD=0.25

# TRACKER_LOST_BUFFER: Number of frames to retain lost tracks before discarding them.
# Current Value: 30 (approx 1 second at 30 FPS)
# Effect: Higher maintains track continuity during brief occlusions behind pillars or people.
TRACKER_LOST_BUFFER=30

# TRACKER_MIN_MATCHING_THRESHOLD: Matching threshold for ByteTrack data association.
# Current Value: 0.80
# Effect: Higher prevents identity swaps during fast movements.
TRACKER_MIN_MATCHING_THRESHOLD=0.80

# TRACKER_FRAME_RATE: Target frame rate for Kalman filter motion projection.
# Current Value: 30
TRACKER_FRAME_RATE=30


# ==============================================================================
# 3. PHASE 2: TEMPORAL ACTION RECOGNITION (OpenCLIP CoCa ViT-L-14)
# ==============================================================================
# This is the most compute-intensive phase. The settings below control the
# balance between detection latency, FPS, and classification accuracy.

# ACTION_DEVICE: Execution device for OpenCLIP CoCa ViT-L-14 action recognition.
# Current Value: cpu
# ------------------------------------------------------------------------------
# WHY SET TO 'cpu' ON LOWER-VRAM SYSTEMS (4GB or below):
#   Reserves 100% of GPU VRAM for YOLO and GUI display, allowing smooth 30-60 FPS
#   video processing without memory bottlenecks.
# ------------------------------------------------------------------------------
# WHY SET TO 'cuda' ON MID-TO-HIGH TIER SYSTEMS (6GB-8GB or higher):
#   Drops CoCa ViT inference time from ~880ms on CPU down to ~25ms on GPU (30x faster),
#   eliminating detection lag and enabling real-time multi-person analysis.
ACTION_DEVICE=cpu

# ACTION_HALF_PRECISION: Enables FP16 for CoCa ViT when running on CUDA.
# Current Value: true
# Options: true, false
# Effect: Cuts OpenCLIP VRAM from ~1.8GB to ~900MB and speeds up GPU tensor calculations.
ACTION_HALF_PRECISION=true

# ACTION_MODEL_NAME & WEIGHTS_PATH:
# Current Value: coca_ViT-L-14 and models/coca_l14.bin
ACTION_MODEL_NAME=coca_ViT-L-14
ACTION_WEIGHTS_PATH=models/coca_l14.bin

# ACTION_SAMPLE_FRAMES: Number of keyframes from the clip evaluated by ViT-L-14.
# Current Value: 1
# ------------------------------------------------------------------------------
# Lower-VRAM Tier (CPU mode): Keep at 1 (~0.88s inference per person).
# Mid-to-High Tier (CUDA mode): Set to 3 or 4.
# ------------------------------------------------------------------------------
# Speed vs Accuracy:
#   1 frame = ViT evaluates action from a single snapshot (fastest, but misses temporal motion).
#   3-4 frames = ViT evaluates start, apex, and impact of a punch/kick across time.
#   Significantly improves action accuracy and reduces false alarms.
ACTION_SAMPLE_FRAMES=1

# ACTION_WINDOW_SIZE: Temporal clip history buffer length (in frames) per person.
# Current Value: 8
# Lower-VRAM Tier: 8 (~0.27 seconds at 30 FPS)
# Mid-to-High Tier: 8 or 16 (16 captures full wind-up and impact of physical altercations)
ACTION_WINDOW_SIZE=8

# ACTION_STRIDE: Emit clips for analysis every N frames.
# Current Value: 4
# Lower-VRAM Tier: 4 (checks for violence every 4 frames)
# Mid-to-High Tier: 2 (checks every 2 frames for near-instant reaction)
# Effect: Lower = faster reaction to sudden movements; Higher = reduced compute load.
ACTION_STRIDE=4

# ACTION_MOTION_THRESHOLD: Motion gating threshold (mean absolute pixel difference).
# Current Value: 15.0
# ------------------------------------------------------------------------------
# Lower-VRAM Tier: 15.0 (Skips idle/stationary people completely, 0% compute overhead).
# Mid-to-High Tier: 8.0 (Catches subtle movements, slow grapples, or concealed aggression).
# ------------------------------------------------------------------------------
# Effect: If inter-frame movement is below this threshold, heavy ViT inference is bypassed.
ACTION_MOTION_THRESHOLD=15.0

# ACTION_ANALYSIS_COOLDOWN: Cooldown interval in seconds before re-analyzing the same person.
# Current Value: 1.5
# ------------------------------------------------------------------------------
# Lower-VRAM Tier: 1.5 (Prevents CPU worker queue from falling behind live video).
# Mid-to-High Tier: 0.3 to 0.5 (Because GPU inference completes in ~25ms, cooldown can be tiny).
# ------------------------------------------------------------------------------
# Effect: Lower reacts to sustained altercations faster; Higher prevents queue congestion.
ACTION_ANALYSIS_COOLDOWN=1.5

# ACTION_CONFIDENCE_THRESHOLD: Minimum confidence (0.0 to 1.0) required to classify action as violent.
# Current Value: 0.60
# Effect: Lower (0.50-0.55) catches softer hits but may increase false alarms; Higher (0.65-0.75) ensures strict precision.
ACTION_CONFIDENCE_THRESHOLD=0.60

# ACTION_ALERT_TRIGGER_COUNT: Consecutive violent strikes needed to escalate to an alert (Orange/Red).
# Current Value: 2
# Options: 1 (instant 1-hit trigger), 2 (balanced 2-hit confirmation), 3 (strict multi-strike confirmation)
ACTION_ALERT_TRIGGER_COUNT=2

# ACTION_OSR_THRESHOLD: Open-Set Recognition threshold for filtering ambiguous postures.
# Current Value: 0.25
# Effect: Filters out idle or ambiguous postures at ~0.20-0.22 similarity while capturing genuine fights at 0.30+.
ACTION_OSR_THRESHOLD=0.25

# ACTION_QUEUE_SIZE: Maximum clip capacity in background analysis queue.
# Current Value: 1
# Lower-VRAM Tier: 1 (Drops stale clips so the queue never lags)
# Mid-to-High Tier: 4 (Analyzes multiple persons in a scene without dropping clips)
ACTION_QUEUE_SIZE=1

# ACTION_CROP_CONTEXT_RATIO: Margin added around person bounding box before action analysis.
# Current Value: 0.20 (20% margin to capture arms, kicks, and interacting persons)
ACTION_CROP_CONTEXT_RATIO=0.20


# ==============================================================================
# 4. PHASE 3: REASONING & INCIDENT REPORTING (Vision-Language Model / VLM)
# ==============================================================================
# Phase 3 sends recorded incident clips to a VLM (Qwen2.5-VL) to produce a structured
# JSON security audit report with threat confirmation and description.

# VLM_ENABLED: Toggle Phase 3 VLM analysis.
# Current Value: false
# Lower-VRAM Tier (4GB): false (A 3B VLM requires 4-8GB VRAM and causes Out-Of-Memory errors)
# Mid-to-High Tier (8GB+): true (When running local Ollama 'qwen2.5vl:3b' or cloud API)
VLM_ENABLED=false

# VLM_PROVIDER: Provider for VLM inference.
# Current Value: local
# Options:
#   - local: Uses local Ollama service (runs on machine)
#   - cloud: Uses Alibaba DashScope / Qwen cloud API (zero local GPU overhead)
VLM_PROVIDER=local

# VLM_MODEL_ID: Ollama model identifier for local inference.
# Current Value: qwen2.5vl:3b
VLM_MODEL_ID=qwen2.5vl:3b

# VLM_CLOUD_MODEL_ID: Cloud model identifier (when VLM_PROVIDER=cloud).
# Current Value: qwen-vl-max
VLM_CLOUD_MODEL_ID=qwen-vl-max

# QWEN_API_KEY: Cloud API key (only required if VLM_PROVIDER=cloud).
# QWEN_API_KEY=your_dashscope_api_key_here

# VLM Keyframe extraction settings:
# VLM_NUM_FRAMES: Number of evenly spaced keyframes sent to VLM (Current: 8)
# VLM_RESIZE_WIDTH & HEIGHT: Resolution of frames sent to VLM (Current: 480x270)
# VLM_JPEG_QUALITY: Compression quality (Current: 80)
VLM_NUM_FRAMES=8
VLM_RESIZE_WIDTH=480
VLM_RESIZE_HEIGHT=270
VLM_JPEG_QUALITY=80


# ==============================================================================
# 5. RECORDING, EVIDENCE STORAGE & PATHS
# ==============================================================================

# INPUT_SOURCE: Default video source (used when no --source CLI argument is passed).
# Current Value: data/inputs/V_120.mp4
# Can be a video path (e.g. data/inputs/V_120.mp4) or camera device index (e.g. 0).
INPUT_SOURCE=data/inputs/V_120.mp4

# OUTPUT_DIR: Destination directory for incident video clips, reports, and screenshots.
# Current Value: data/outputs/
OUTPUT_DIR=data/outputs/

# MODEL_DIR: Directory where model weights are stored.
# Current Value: models/
MODEL_DIR=models/

# RECORD_INCIDENT: Automatically record .mp4 evidence clips upon violence escalation.
# Current Value: true
RECORD_INCIDENT=true

# SAVE_SCREENSHOT: Save high-resolution .jpg snapshot at the instant violence is detected.
# Current Value: true
SAVE_SCREENSHOT=true

# PRE_EVENT_SECONDS: Seconds of video buffered BEFORE the violent action began.
# Current Value: 2
PRE_EVENT_SECONDS=2

# POST_EVENT_SECONDS: Seconds of aftermath video recorded AFTER violence is confirmed.
# Current Value: 3
POST_EVENT_SECONDS=3


# ==============================================================================
# 6. WEB SURVEILLANCE DASHBOARD (run_web.py)
# ==============================================================================

# WEB_HOST: Host IP address for web dashboard.
# Current Value: 0.0.0.0 (allows LAN/WiFi access from other devices)
WEB_HOST=0.0.0.0

# WEB_PORT: Port number for web dashboard.
# Current Value: 5000
WEB_PORT=5000

# WEB_STREAM_JPEG_QUALITY: MJPEG streaming quality for web browser video feed (1-100).
# Current Value: 80
# Effect: Lowering to 60-70 reduces network bandwidth; 80-90 delivers crisp video.
WEB_STREAM_JPEG_QUALITY=80


# ==============================================================================
# 7. MONGODB INCIDENT ARCHIVE & CLOUD STORAGE
# ==============================================================================
# Offloads forensic video clips, keyframe snapshots, and incident metadata to MongoDB.
# Operates asynchronously in a dedicated background worker thread with a gentle
# upload delay, ensuring ZERO impact on camera framerate or AI detection flow.

# MONGODB_ENABLED: Enable or disable MongoDB uploads.
# Current Value: false
# Options: true, false
MONGODB_ENABLED=false

# MONGODB_URI: Connection URI for your local or remote MongoDB instance.
# You can include your database name directly in the URI path (e.g., .../sentinai_surveillance).
# Examples:
#   - Local: mongodb://localhost:27017
#   - Local with DB: mongodb://localhost:27017/sentinai_surveillance
#   - Auth:  mongodb://username:password@localhost:27017/sentinai_surveillance?authSource=admin
#   - Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/sentinai_surveillance?retryWrites=true&w=majority
# Current Value: mongodb://localhost:27017
MONGODB_URI=mongodb://localhost:27017

# MONGODB_UPLOAD_DELAY_SECONDS: Sleep delay before uploading newly recorded clips.
# Current Value: 2.0
# Effect: Postpones network transfer briefly so system resources remain 100% free
#         during immediate incident aftermath before pushing to the database.
MONGODB_UPLOAD_DELAY_SECONDS=2.0

# MONGODB_UPLOAD_VIDEOS: Upload binary .mp4 video recordings via GridFS.
# Current Value: true
# Options: true, false
MONGODB_UPLOAD_VIDEOS=true

# MONGODB_UPLOAD_SCREENSHOTS: Upload keyframe screenshot images via GridFS.
# Current Value: true
# Options: true, false
MONGODB_UPLOAD_SCREENSHOTS=true

# MONGODB_TIMEOUT_MS: Server selection & connection timeout in milliseconds.
# Current Value: 5000 (5 seconds)
# Effect: Prevents background worker from hanging if the database is temporarily unreachable.
MONGODB_TIMEOUT_MS=5000

