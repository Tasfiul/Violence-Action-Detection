# .gitignore

# 1. Python Artifacts & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
venv/
.venv/
env/
ENV/

# Environment Configuration Files (Keep examples, ignore actual secrets)
.env
.env.*
!.env.example
thresholds.env
thresholds.env.*
!thresholds.env.example

# Temporary and Download Files
*.tmp
*.temp
*.download

# 2. Large Data Files (NEVER commit these)
data/inputs/*
data/outputs/*
data/save/*
data/safe/*
data/violent/*
data/dataset/*
!data/inputs/.gitkeep
!data/outputs/.gitkeep
!data/inputs/NOTE.txt
!data/outputs/NOTE.txt
!data/outputs/incident_20260223-1641271.mp4
!data/outputs/incident_20260223-1641271-ezgif.com-video-to-gif-converter.gif

# 3. Model Weights (Too big for GitHub)
models/*.pt
models/*.pth
models/*.bin
models/*.safetensors
models/*.json
models/*.txt
models/*.py
!models/NOTE.txt
!models/Note.txt
!models/.gitkeep

# 4. Evidence/Logs
evidence/*
logs/*
!evidence/.gitkeep
!logs/.gitkeep

# 5. IDE & OS Settings
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini