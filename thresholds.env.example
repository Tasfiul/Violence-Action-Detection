# ==============================================================================
# SENTINAI // DETECTION THRESHOLDS & SENSITIVITY TEMPLATE (thresholds.env.example)
# ==============================================================================
# Copy this file to `thresholds.env` to customize detection sensitivity.
# This file centralizes ALL detection thresholds, confidence gates, motion filters,
# and alarm sensitivity rules for the Violence Action Detection system.
#
# QUICK SENSITIVITY PRESETS:
# ------------------------------------------------------------------------------
# [PRESET 1] BALANCED (Default - Recommended for General CCTV Monitoring):
#   - DETECTION_CONF_THRESHOLD=0.50
#   - ACTION_MOTION_THRESHOLD=15.0
#   - ACTION_CONFIDENCE_THRESHOLD=0.60
#   - ACTION_OSR_THRESHOLD=0.25
#   - ACTION_ALERT_TRIGGER_COUNT=2
#   * Low false-alarm rate while reliably flagging real fights and punches.
#
# [PRESET 2] HIGH SENSITIVITY (Zero-Tolerance / High-Security Zones):
#   - DETECTION_CONF_THRESHOLD=0.40
#   - ACTION_MOTION_THRESHOLD=8.0
#   - ACTION_CONFIDENCE_THRESHOLD=0.52
#   - ACTION_OSR_THRESHOLD=0.22
#   - ACTION_ALERT_TRIGGER_COUNT=1
#   * Triggers on single hits, aggressive shoves, grappling, or subtle altercations.
#
# [PRESET 3] HIGH PRECISION (Strict Verification / Zero False Alarms):
#   - DETECTION_CONF_THRESHOLD=0.60
#   - ACTION_MOTION_THRESHOLD=20.0
#   - ACTION_CONFIDENCE_THRESHOLD=0.70
#   - ACTION_OSR_THRESHOLD=0.30
#   - ACTION_ALERT_TRIGGER_COUNT=3
#   * Only sounds the alarm for sustained, unambiguous, violent brawls.
# ==============================================================================


# ==============================================================================
# 1. PHASE 1: SPATIAL PERCEPTION & TRACKING THRESHOLDS
# ==============================================================================

# DETECTION_CONF_THRESHOLD: Minimum confidence score to detect a person.
# Current Value: 0.50
# Range: 0.10 to 0.90
# ------------------------------------------------------------------------------
# Lower (0.35 - 0.45): Detects partially obscured people, people far in the
#                      background, or in low-light conditions.
# Higher (0.55 - 0.70): Strictly detects clear, unobstructed persons; reduces
#                      tracker processing on blurry background shapes.
DETECTION_CONF_THRESHOLD=0.50

# DETECTION_IOU_THRESHOLD: Non-Maximum Suppression (NMS) IoU overlap threshold.
# Current Value: 0.45
# Range: 0.20 to 0.70
# ------------------------------------------------------------------------------
# Lower (0.30 - 0.40): Merges overlapping bounding boxes aggressively.
# Higher (0.50 - 0.60): Keeps separate bounding boxes when two people are close
#                      together, grappling, or fighting hand-to-hand.
DETECTION_IOU_THRESHOLD=0.45

# TRACKER_ACTIVATION_THRESHOLD: Minimum score to initialize a new person track in ByteTrack.
# Current Value: 0.25
# Range: 0.10 to 0.60
# ------------------------------------------------------------------------------
# Lower = initializes tracks faster as people enter the camera view.
# Higher = waits until a person is clearly visible before tracking them.
TRACKER_ACTIVATION_THRESHOLD=0.25

# TRACKER_MIN_MATCHING_THRESHOLD: Minimum association score to match a person across frames.
# Current Value: 0.80
# Range: 0.50 to 0.95
# ------------------------------------------------------------------------------
# Higher = stricter identity matching (prevents ID swapping during fast motion).
# Lower = tolerates rapid or erratic jumps across frames.
TRACKER_MIN_MATCHING_THRESHOLD=0.80

# TRACKER_LOST_BUFFER: Number of video frames to remember a lost track before discarding it.
# Current Value: 30 (approx. 1.0 second at 30 FPS)
# Range: 10 to 90
# ------------------------------------------------------------------------------
# If a person walks behind a post or another person, ByteTrack remembers their ID
# for this many frames so their alert status is not lost when they reappear.
TRACKER_LOST_BUFFER=30


# ==============================================================================
# 2. PHASE 2: MOTION GATING & ACTION CLASSIFICATION THRESHOLDS
# ==============================================================================

# ACTION_MOTION_THRESHOLD: Inter-frame pixel motion gatekeeper (Mean Absolute Difference).
# Current Value: 15.0
# Range: 2.0 to 35.0
# ------------------------------------------------------------------------------
# PURPOSE: Skips heavy neural action recognition if the person is idle or stationary (0% compute).
# Lower (5.0 - 8.0): Highly sensitive. Analyzes even subtle movement (slow wrestling,
#                    subtle weapon draws, or creeping motion).
# Higher (20.0 - 30.0): Ignores walking and hand waving; only triggers on explosive,
#                      fast-moving physical actions (punches, kicks, fast falls).
ACTION_MOTION_THRESHOLD=15.0

# ACTION_CONFIDENCE_THRESHOLD: Minimum AI confidence to classify an action as VIOLENT.
# Current Value: 0.60 (60%)
# Range: 0.40 to 0.85
# ------------------------------------------------------------------------------
# Lower (0.50 - 0.55): Catches softer hits, pushes, or ambiguous aggression, but may
#                      occasionally flag dramatic gestures or dancing.
# Higher (0.70 - 0.80): High precision. Only triggers when the model is exceptionally
#                      confident the action is violent.
ACTION_CONFIDENCE_THRESHOLD=0.60

# ACTION_OSR_THRESHOLD: Open-Set Recognition (OSR) Gatekeeper Threshold.
# Current Value: 0.25
# Range: 0.18 to 0.35
# ------------------------------------------------------------------------------
# PURPOSE: Filters out unknown postures that don't match any trained concepts.
# OpenCLIP cosine similarity baseline for benign/idle postures is ~0.20-0.22.
# Genuine fights score ~0.30 to 0.45+.
# If max similarity < OSR threshold, the model is guessing blindly and forced to "safe".
# Lower = more permissive.
# Higher = strictly filters ambiguous postures.
ACTION_OSR_THRESHOLD=0.25

# ACTION_ALERT_TRIGGER_COUNT: Consecutive strikes required to escalate to an alert.
# Current Value: 2
# Range: 1 to 5
# ------------------------------------------------------------------------------
# 1 = INSTANT TRIGGER (1 detection = instant alert). Fast response, but sensitive to single-frame glitches.
# 2 = BALANCED (2 consecutive hits = alert). Filters transient false detections.
# 3-4 = STRICT (Requires sustained fighting over 1-2 seconds).
ACTION_ALERT_TRIGGER_COUNT=2

# ACTION_ANALYSIS_COOLDOWN: Cooldown interval in seconds before re-analyzing the same person.
# Current Value: 1.5 (CPU) / 0.3 - 0.5 (GPU)
# Range: 0.1 to 3.0
# ------------------------------------------------------------------------------
# Controls how quickly the system re-checks a person after analyzing them.
ACTION_ANALYSIS_COOLDOWN=1.5

# ACTION_CROP_CONTEXT_RATIO: Bounding box padding ratio added around the person.
# Current Value: 0.20 (20% margin around box)
# Range: 0.05 to 0.40
# ------------------------------------------------------------------------------
# Adds margin around the person crop so outstretched arms, swings, and interacting
# persons are captured inside the clip fed to the action recognizer.
ACTION_CROP_CONTEXT_RATIO=0.20


# ==============================================================================
# 3. STATE MACHINE & THREAT ESCALATION THRESHOLDS
# ==============================================================================

# STATE_TIMEOUT_SECONDS: Memory retention time (in seconds) for inactive persons.
# Current Value: 10.0
# Range: 3.0 to 60.0
# ------------------------------------------------------------------------------
# If a person leaves the camera view, their alert level (Orange/Red) and incident
# state are retained in memory for this many seconds before being wiped clean.
STATE_TIMEOUT_SECONDS=10.0
